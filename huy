-- RESPAWN: GIỮ SPEED
--==================================================

player.CharacterAdded:Connect(function(character)
	local humanoid = character:WaitForChild("Humanoid")

	task.wait(0.2)

	local value = tonumber(speedBox.Text)

	if value then
		humanoid.WalkSpeed = math.clamp(value, 1, MAX_SPEED)
	end
end)

